# ── Серверные переменные ─────────────────────────────────────────────
# Без префикса VITE_ — эти значения НИКОГДА не попадают в клиентский бандл.
# На Vercel задаются в Project Settings → Environment Variables,
# а не в этом файле.

# Ключ Gemini. Используется только внутри /api/gemini.
# Не добавляйте сюда префикс VITE_ — это вернёт утечку ключа в браузер.
GEMINI_API_KEY=

# Домены, которым разрешено обращаться к /api/gemini, через запятую.
# Если не задать — берётся список по умолчанию из api/_gemini.ts.
ALLOWED_ORIGINS=https://francabulaire.vercel.app

# Потолок запросов к прокси с одного IP в минуту (по умолчанию 30).
GEMINI_RATE_LIMIT=30

# ── Клиентские переменные ────────────────────────────────────────────
# Префикс VITE_ означает «попадёт в бандл и будет виден всем».
# Для конфигурации Firebase это штатно и безопасно.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
